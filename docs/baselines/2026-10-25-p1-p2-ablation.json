    "harness_source": "mod line_index {\n    #[derive(Clone, Copy, Debug, PartialEq, Eq)]\n    pub struct LineCol { pub line: u32, pub col: u32 }\n}\n#[path = \"text-document-checkpoint.rs\"] mod checkpoint;\n#[path = \"text-document-retained.rs\"] mod retained;\nfn main() {\n    use line_index::LineCol;\n    for size in [80, 10_000, 1_000_000] {\n        for run in 0..3 {\n            let content = format!(\"a\\n{}\\n\", \"x\".repeat(size));\n            let mut before = checkpoint::TextDocument::new(content.clone());\n            let mut after = retained::TextDocument::new(content);\n            let a = checkpoint::TextChange { range: Some(checkpoint::TextChangeRange {\n                start: LineCol { line: 0, col: 0 }, end: LineCol { line: 0, col: 1 }\n            }), text: \"b\".into() };\n            let b = retained::TextChange { range: Some(retained::TextChangeRange {\n                start: LineCol { line: 0, col: 0 }, end: LineCol { line: 0, col: 1 }\n            }), text: \"b\".into() };\n            let start = std::time::Instant::now();\n            for _ in 0..1000 { std::hint::black_box(&mut before).update(&a); }\n            let old = start.elapsed().as_nanos();\n            let start = std::time::Instant::now();\n            for _ in 0..1000 { std::hint::black_box(&mut after).update(&b); }\n            let new = start.elapsed().as_nanos();\n            assert_eq!(before.text(), after.text());\n            println!(\"{} {} {} {}\", size, run, old, new);\n        }\n    }\n}\n",
    "build_command": "rustc +1.97.1 --edition=2021 -O target/ablation/2026-10-25-p1-p2/text-update-bench.rs -o target/ablation/2026-10-25-p1-p2/text-update-bench",
