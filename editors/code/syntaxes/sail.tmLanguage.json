{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Sail",
  "scopeName": "source.sail",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#bitvectors" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#pragmas" },
    { "include": "#includes" },
    { "include": "#functions" },
    { "include": "#type_variables" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.sail",
          "match": "//.*$"
        },
        {
          "name": "comment.block.sail",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            { "include": "#comments" }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.sail",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.sail",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.sail",
          "match": "\\b0x[0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.sail",
          "match": "\\b0b[01_]+\\b"
        },
        {
          "name": "constant.numeric.decimal.sail",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "bitvectors": {
      "patterns": [
        {
          "name": "constant.numeric.bitvector.sail",
          "match": "0b[01_]+"
        },
        {
          "name": "constant.numeric.hexvector.sail",
          "match": "0x[0-9a-fA-F_]+"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.sail",
          "match": "\\b(if|then|else|match|case|switch|foreach|while|repeat|until|do|return|throw|try|catch|exit|assert|when|from|to|by|downto|in|end)\\b"
        },
        {
          "name": "keyword.declaration.sail",
          "match": "\\b(val|function|mapping|let|var|register|type|struct|enum|union|bitfield|newtype|scattered|clause|overload|operator|outcome|default|constant|config|configuration|instantiation|impl|mutual|constraint|dec)\\b"
        },
        {
          "name": "keyword.other.sail",
          "match": "\\b(forall|as|with|ref|cast|sizeof|pure|monadic|effect|private|forwards|backwards|infix|infixl|infixr|termination_measure|depend|and)\\b"
        },
        {
          "name": "storage.modifier.sail",
          "match": "\\b(inc|dec)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.builtin.sail",
          "match": "\\b(int|nat|bool|bit|unit|string|real|atom|range|vector|list|option|result|bits|Order|Bool|Int|Type)\\b"
        },
        {
          "name": "entity.name.type.sail",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.sail",
          "match": "\\b(true|false|bitzero|bitone|undefined|unspec|undef)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.sail",
          "match": "->|<->|=>|:=|==|!=|>=|<=|>>|<<|\\|\\||&&|@|\\^|~"
        },
        {
          "name": "keyword.operator.assignment.sail",
          "match": "="
        }
      ]
    },
    "pragmas": {
      "patterns": [
        {
          "name": "meta.preprocessor.sail",
          "match": "^\\s*\\$\\[.*\\]"
        },
        {
          "name": "meta.preprocessor.include.sail",
          "match": "^\\s*\\$include\\b.*$"
        }
      ]
    },
    "includes": {
      "patterns": [
        {
          "name": "keyword.control.import.sail",
          "match": "\\$include"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(function|val|mapping)\\s+(clause\\s+)?([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.sail" },
            "2": { "name": "keyword.declaration.sail" },
            "3": { "name": "entity.name.function.sail" }
          }
        }
      ]
    },
    "type_variables": {
      "patterns": [
        {
          "name": "variable.other.type.sail",
          "match": "'[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    }
  }
}
