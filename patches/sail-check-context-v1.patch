index 7ca4a5e76..5c06df0af 100644
--- a/src/bin/sail.ml
+++ b/src/bin/sail.ml
@@ -67,6 +67,45 @@ let opt_all_modules = ref false
 let opt_show_sail_dir = ref false
 let opt_project_files : string list ref = ref []
 let opt_variable_assignments : string list ref = ref []
+let check_variables = ref Util.StringMap.empty
+
+(* Versioned, typed check context. Paths are absolute so project-directory
+   changes cannot alter include search or generated-source identity. *)
+let parse_check_context text =
+  let bad message = raise (Arg.Bad ("--check-context: " ^ message)) in
+  let absolute = function
+    | `String path when not (Filename.is_relative path) -> path
+    | _ -> bad "expected an absolute path"
+  in
+  let fields =
+    try match Yojson.Safe.from_string text with `Assoc fields -> fields | _ -> bad "expected an object"
+    with Yojson.Json_error message -> bad message
+  in
+  let get name = match List.assoc_opt name fields with Some value -> value | None -> bad ("missing " ^ name) in
+  List.iter (fun (name, _) ->
+    if not (List.mem name ["version"; "target"; "includePaths"; "variables"; "generatedFiles"]) then
+      bad ("unknown field " ^ name)) fields;
+  if get "version" <> `Int 1 then bad "unsupported version";
+  let target = match get "target" with `Null -> None | `String name -> Some name | _ -> bad "invalid target" in
+  let includes = match get "includePaths" with `List paths -> List.map absolute paths | _ -> bad "invalid includePaths" in
+  let variables = match get "variables" with
+    | `Assoc vars -> List.fold_left (fun map (name, value) ->
+        let value = match value with
+          | `Bool b -> Project.bool_value b
+          | `String s -> Project.string_value s
+          | _ -> bad ("variable " ^ name ^ " must be a boolean or string")
+        in Util.StringMap.add name value map) Util.StringMap.empty vars
+    | _ -> bad "invalid variables"
+  in
+  let generated = match get "generatedFiles" with
+    | `Assoc files -> List.fold_left (fun map (name, path) -> Util.StringMap.add name (absolute path) map) Util.StringMap.empty files
+    | _ -> bad "invalid generatedFiles"
+  in
+  Preprocess.check_target := target;
+  Preprocess.include_paths := includes;
+  Project.virtual_file_paths := generated;
+  check_variables := variables;
+  opt_just_check := true
 let opt_model_config_file : string option ref = ref None
 let opt_sail_config_file : string option ref = ref None
 let opt_slice_instantiation_types : bool ref = ref false
@@ -239,6 +278,8 @@ let rec options =
         Arg.String (fun assignment -> opt_variable_assignments := assignment :: !opt_variable_assignments),
         "<variable=value> assign a module variable to a value"
       );
+      ("-check_context_version", Arg.Unit (fun () -> print_endline "1"; exit 0), " print supported check-context protocol version");
+      ("-check_context", Arg.String parse_check_context, "<json> typed check-only context (protocol version 1)");
       ( "-instantiate",
         Arg.String (fun inst -> parse_instantiation inst),
         " <type variable=value> instantiate an abstract type variable"
@@ -496,6 +537,7 @@ let run_sail (config : Yojson.Safe.t option) tgt =
               raise (Reporting.err_general Parse_ast.Unknown ("Could not parse assignment " ^ assignment))
           )
           !opt_variable_assignments;
+        variables := Util.StringMap.union (fun _ _ context -> Some context) !variables !check_variables;
         let modules = if !opt_all_modules then None else Some frees in
         Frontend.load_project ~no_core:!opt_no_core ~target:tgt ?modules ~options:!options ~variables
           ~just_parse:!opt_just_parse_project ~default_sail_dir:Locations.sail_dir project_files
