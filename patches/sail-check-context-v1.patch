diff --git a/test/unit/test_check_context.ml b/test/unit/test_check_context.ml
new file mode 100644
index 000000000..745f65417
--- /dev/null
+++ b/test/unit/test_check_context.ml
@@ -0,0 +1,63 @@
+open Libsail
+
+let base =
+  [
+    ("version", `Int 1);
+    ("target", `Null);
+    ("includePaths", `List []);
+    ("variables", `Assoc []);
+    ("generatedFiles", `Assoc []);
+  ]
+let parse fields = Check_context.parse (Yojson.Safe.to_string (`Assoc fields))
+let replace name value = (name, value) :: List.remove_assoc name base
+let invalid fields () =
+  match parse fields with Error _ -> () | Ok _ -> Alcotest.fail "invalid check context was accepted"
+
+let suites =
+  [
+    ( "check context",
+      [
+        Alcotest.test_case "typed values and path order" `Quick (fun () ->
+            let fields =
+              List.map
+                (function
+                  | "variables", _ ->
+                      ("variables", `Assoc [("A", `Bool true); ("B", `String "true"); ("C", `String " padded ")])
+                  | "includePaths", _ -> ("includePaths", `List [`String "/second"; `String "/first"])
+                  | "generatedFiles", _ ->
+                      ("generatedFiles", `Assoc [("generated.sail", `String "/physical/source.sail")])
+                  | field -> field
+                  )
+                base
+            in
+            match parse fields with
+            | Error message -> Alcotest.fail message
+            | Ok context ->
+                Alcotest.(check (list string)) "ordered fallback paths" ["/second"; "/first"] context.include_paths;
+                assert (
+                  context.variables
+                  = [
+                      ("A", Check_context.Bool true);
+                      ("B", Check_context.String "true");
+                      ("C", Check_context.String " padded ");
+                    ]
+                );
+                Alcotest.(check (list (pair string string)))
+                  "physical virtual source"
+                  [("generated.sail", "/physical/source.sail")]
+                  context.generated_files
+        );
+        Alcotest.test_case "unknown version" `Quick (invalid (replace "version" (`Int 2)));
+        Alcotest.test_case "missing version" `Quick (invalid (List.remove_assoc "version" base));
+        Alcotest.test_case "unknown field" `Quick (invalid (("future", `Bool true) :: base));
+        Alcotest.test_case "duplicate field" `Quick (invalid (("version", `Int 1) :: base));
+        Alcotest.test_case "duplicate variable" `Quick
+          (invalid (replace "variables" (`Assoc [("X", `Bool true); ("X", `Bool false)])));
+        Alcotest.test_case "relative include" `Quick (invalid (replace "includePaths" (`List [`String "relative"])));
+        Alcotest.test_case "relative generated file" `Quick
+          (invalid (replace "generatedFiles" (`Assoc [("x", `String "relative")])));
+        Alcotest.test_case "numeric variable" `Quick (invalid (replace "variables" (`Assoc [("X", `Int 1)])));
+        Alcotest.test_case "malformed JSON" `Quick (fun () -> assert (Result.is_error (Check_context.parse "{")));
+      ]
+    );
+  ]
