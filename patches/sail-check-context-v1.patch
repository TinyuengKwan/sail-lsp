diff --git a/src/lib/check_context.ml b/src/lib/check_context.ml
new file mode 100644
index 000000000..3c1b2c7ed
--- /dev/null
+++ b/src/lib/check_context.ml
@@ -0,0 +1,63 @@
+type variable = Bool of bool | String of string
+
+type t = {
+  target : string option;
+  include_paths : string list;
+  variables : (string * variable) list;
+  generated_files : (string * string) list;
+}
+
+let version = 1
+
+exception Invalid of string
+
+let parse text =
+  let bad message = raise (Invalid message) in
+  let object_fields name = function
+    | `Assoc fields ->
+        let _ =
+          List.fold_left
+            (fun seen (key, _) ->
+              if Util.StringSet.mem key seen then bad ("duplicate " ^ name ^ " field " ^ key);
+              Util.StringSet.add key seen
+            )
+            Util.StringSet.empty fields
+        in
+        fields
+    | _ -> bad ("expected " ^ name ^ " object")
+  in
+  let absolute = function
+    | `String path when not (Filename.is_relative path) -> path
+    | _ -> bad "expected an absolute path"
+  in
+  try
+    let fields = object_fields "context" (Yojson.Safe.from_string text) in
+    let get name = match List.assoc_opt name fields with Some value -> value | None -> bad ("missing " ^ name) in
+    List.iter
+      (fun (name, _) ->
+        if not (List.mem name ["version"; "target"; "includePaths"; "variables"; "generatedFiles"]) then
+          bad ("unknown field " ^ name)
+      )
+      fields;
+    if get "version" <> `Int version then bad "unsupported version";
+    let target = match get "target" with `Null -> None | `String name -> Some name | _ -> bad "invalid target" in
+    let include_paths =
+      match get "includePaths" with `List paths -> List.map absolute paths | _ -> bad "invalid includePaths"
+    in
+    let variables =
+      object_fields "variables" (get "variables")
+      |> List.map (fun (name, value) ->
+          let value =
+            match value with
+            | `Bool b -> Bool b
+            | `String s -> String s
+            | _ -> bad ("variable " ^ name ^ " must be a boolean or string")
+          in
+          (name, value)
+      )
+    in
+    let generated_files =
+      object_fields "generatedFiles" (get "generatedFiles") |> List.map (fun (name, value) -> (name, absolute value))
+    in
+    Ok { target; include_paths; variables; generated_files }
+  with Invalid message | Yojson.Json_error message -> Error message
