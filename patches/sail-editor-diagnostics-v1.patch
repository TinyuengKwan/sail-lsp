+++ b/src/lib/editor_diagnostics.mli
@@ -0,0 +1,32 @@
+(* SPDX-License-Identifier: BSD-2-Clause *)
+(** Versioned check-only diagnostics, independent of terminal rendering. *)
+val version : int
+
+val enable : unit -> unit
+val enabled : unit -> bool
+val fingerprint : string -> string
+val span : Parse_ast.l -> Yojson.Safe.t option
+
+type edit = { location : Parse_ast.l; replacement : string }
+type fix = { title : string; edits : edit list }
+
+val replacement : title:string -> Parse_ast.l -> (string -> string) -> fix option
+
+val diagnostic :
+  severity:string ->
+  code:string ->
+  message:string ->
+  location:Parse_ast.l ->
+  related:(Parse_ast.l * string) list ->
+  fixes:fix list ->
+  Yojson.Safe.t
+val emit :
+  severity:string ->
+  code:string ->
+  message:string ->
+  location:Parse_ast.l ->
+  ?related:(Parse_ast.l * string) list ->
+  ?fixes:fix list ->
+  unit ->
+  unit
+val finish : bool -> unit
