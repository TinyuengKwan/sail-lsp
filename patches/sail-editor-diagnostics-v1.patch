diff --git a/src/lib/editor_diagnostics.ml b/src/lib/editor_diagnostics.ml
new file mode 100644
index 000000000..7c9a94bf1
--- /dev/null
+++ b/src/lib/editor_diagnostics.ml
@@ -0,0 +1,136 @@
+(* SPDX-License-Identifier: BSD-2-Clause *)
+let version = 1
+let active = ref false
+let finished = ref false
+let count = ref 0
+let enable () = active := true
+let enabled () = !active
+
+(* Source identity, not a security hash. Hash the compiler's loaded bytes,
+   including CRLF and trailing newlines, rather than re-reading disk. *)
+let fingerprint text =
+  let hash = ref 0xcbf29ce484222325L in
+  String.iter (fun c -> hash := Int64.mul (Int64.logxor !hash (Int64.of_int (Char.code c))) 0x100000001b3L) text;
+  Printf.sprintf "%016Lx" !hash
+
+let sources = Hashtbl.create 16
+let source handle =
+  match Hashtbl.find_opt sources handle with
+  | Some source -> source
+  | None ->
+      let text = Sail_file.contents handle in
+      let hash = `Assoc [("algorithm", `String "fnv1a64"); ("value", `String (fingerprint text))] in
+      Hashtbl.add sources handle (text, hash);
+      (text, hash)
+
+let rec positions = function
+  | Parse_ast.Range (p1, p2) -> Some (p1, p2)
+  | Parse_ast.Unique (_, l) | Parse_ast.Generated l -> positions l
+  | Parse_ast.Hint (_, l1, l2) -> (
+      match positions l2 with Some _ as p -> p | None -> positions l1
+    )
+  | Parse_ast.Unknown -> None
+
+let byte_boundary text offset = offset = 0 || offset = String.length text || Char.code text.[offset] land 0xc0 <> 0x80
+
+let span location =
+  match positions location with
+  | None -> None
+  | Some ((p1 : Sail_file.position), p2) ->
+      let path = Sail_file.to_path p1.pos_fname in
+      let contents, hash = source p1.pos_fname in
+      if
+        Sail_file.Path.is_virtual path
+        || (not (Sail_file.handle_equal p1.pos_fname p2.pos_fname))
+        || p1.pos_cnum < 0 || p2.pos_cnum < p1.pos_cnum
+        || p2.pos_cnum > String.length contents
+        || (not (byte_boundary contents p1.pos_cnum))
+        || not (byte_boundary contents p2.pos_cnum)
+      then None
+      else (
+        let file = Sail_file.Path.to_string path in
+        let file = if Filename.is_relative file then Filename.concat (Sys.getcwd ()) file else file in
+        Some
+          (`Assoc
+             [
+               ("file", `String file);
+               ("byteStart", `Int p1.pos_cnum);
+               ("byteEnd", `Int p2.pos_cnum);
+               ("sourceHash", hash);
+             ]
+          )
+      )
+
+let rec hints = function
+  | Parse_ast.Hint (message, l1, l2) -> (l1, message) :: hints l2
+  | Parse_ast.Generated l | Parse_ast.Unique (_, l) -> hints l
+  | _ -> []
+
+type edit = { location : Parse_ast.l; replacement : string }
+type fix = { title : string; edits : edit list }
+
+let edit_json edit =
+  match (span edit.location, positions edit.location) with
+  | Some span, Some (p1, p2) ->
+      let old_text = String.sub (fst (source p1.pos_fname)) p1.pos_cnum (p2.pos_cnum - p1.pos_cnum) in
+      Some (`Assoc [("span", span); ("oldText", `String old_text); ("newText", `String edit.replacement)])
+  | _ -> None
+
+let replacement ~title location transform =
+  match (span location, positions location) with
+  | Some _, Some (p1, p2) ->
+      let text = String.sub (fst (source p1.pos_fname)) p1.pos_cnum (p2.pos_cnum - p1.pos_cnum) in
+      Some { title; edits = [{ location; replacement = transform text }] }
+  | _ -> None
+
+let fix_json fix =
+  let edits = List.filter_map edit_json fix.edits in
+  if edits = [] || List.length edits <> List.length fix.edits then None
+  else Some (`Assoc [("title", `String fix.title); ("edits", `List edits)])
+
+let diagnostic ~severity ~code ~message ~location ~related ~fixes =
+  let primary = span location in
+  let related =
+    related @ hints location
+    |> List.filter_map (fun (l, message) ->
+        Option.map (fun span -> `Assoc [("span", span); ("message", `String message)]) (span l)
+    )
+  in
+  `Assoc
+    [
+      ("protocol", `String "sail-editor-diagnostics");
+      ("version", `Int version);
+      ("event", `String "diagnostic");
+      ("severity", `String severity);
+      ("code", `String code);
+      ("message", `String message);
+      ("span", Option.value ~default:`Null primary);
+      ("related", `List related);
+      ("fixes", `List (if primary = None then [] else List.filter_map fix_json fixes));
+    ]
+
+let emit ~severity ~code ~message ~location ?(related = []) ?(fixes = []) () =
+  if !active then (
+    incr count;
+    Printf.printf "%s\n%!" (Yojson.Safe.to_string (diagnostic ~severity ~code ~message ~location ~related ~fixes))
+  )
+
+let finish success =
+  if !active && not !finished then (
+    finished := true;
+    Printf.printf "%s\n%!"
+      (Yojson.Safe.to_string
+         (`Assoc
+            [
+              ("protocol", `String "sail-editor-diagnostics");
+              ("version", `Int version);
+              ("event", `String "summary");
+              ("success", `Bool success);
+              ("diagnostics", `Int !count);
+            ]
+         )
+      )
+  )
+
+(* An unexpected exception or an early exit cannot look like a clean check. *)
+let () = at_exit (fun () -> finish false)
