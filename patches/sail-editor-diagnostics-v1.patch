diff --git a/test/unit/test_editor_diagnostics.ml b/test/unit/test_editor_diagnostics.ml
new file mode 100644
index 000000000..31564db40
--- /dev/null
+++ b/test/unit/test_editor_diagnostics.ml
@@ -0,0 +1,66 @@
+(* SPDX-License-Identifier: BSD-2-Clause *)
+open Libsail
+open Yojson.Safe.Util
+
+let with_source text test =
+  let file = Filename.temp_file "sail-editor-json" ".sail" in
+  let output = open_out_bin file in
+  output_string output text;
+  close_out output;
+  Fun.protect
+    ~finally:(fun () -> Sys.remove file)
+    (fun () ->
+      let handle = Sail_file.open_file (Sail_file.Path.actual file) in
+      let at offset = { Sail_file.Position.pos_fname = handle; pos_cnum = offset; pos_lnum = 1; pos_bol = 0 } in
+      test file handle (fun first last -> Parse_ast.Range (at first, at last))
+    )
+
+let suites =
+  [
+    ( "editor diagnostics",
+      [
+        Alcotest.test_case "portable source hash vectors" `Quick (fun () ->
+            Alcotest.(check string) "empty" "cbf29ce484222325" (Editor_diagnostics.fingerprint "");
+            Alcotest.(check string) "hello" "a430d84680aabd0b" (Editor_diagnostics.fingerprint "hello")
+        );
+        Alcotest.test_case "UTF-8 CRLF byte spans and fix guards" `Quick (fun () ->
+            let text = "let banner = \"🙂\"\r\nlet value = 0xAb\r\n" in
+            with_source text (fun file handle location ->
+                Alcotest.(check string) "raw bytes" text (Sail_file.contents handle);
+                let first = String.index text '0' in
+                let fix =
+                  {
+                    Editor_diagnostics.title = "Lowercase hexadecimal digits";
+                    edits = [{ Editor_diagnostics.location = location first (first + 4); replacement = "0xab" }];
+                  }
+                in
+                let value =
+                  Editor_diagnostics.diagnostic ~severity:"warning" ~code:"hex-case" ~message:"Mixed case"
+                    ~location:(location first (first + 4))
+                    ~related:[(location 0 3, "declaration")]
+                    ~fixes:[fix]
+                in
+                Alcotest.(check int) "first byte" first (value |> member "span" |> member "byteStart" |> to_int);
+                Alcotest.(check string) "physical path" file (value |> member "span" |> member "file" |> to_string);
+                Alcotest.(check string)
+                  "guard" "0xAb"
+                  (value |> member "fixes" |> to_list |> List.hd |> member "edits" |> to_list |> List.hd
+                 |> member "oldText" |> to_string
+                  );
+                Alcotest.(check int) "related" 1 (value |> member "related" |> to_list |> List.length)
+            )
+        );
+        Alcotest.test_case "invalid and virtual spans are never invented" `Quick (fun () ->
+            assert (Editor_diagnostics.span Parse_ast.Unknown = None);
+            with_source "abc" (fun _ _ location ->
+                assert (Editor_diagnostics.span (location (-1) 0) = None);
+                assert (Editor_diagnostics.span (location 0 4) = None)
+            );
+            let _, handle = Sail_file.add_virtual_file ~contents:"abc" "editor-virtual" in
+            let p = { Sail_file.Position.pos_fname = handle; pos_cnum = 0; pos_lnum = 1; pos_bol = 0 } in
+            assert (Editor_diagnostics.span (Parse_ast.Range (p, p)) = None);
+            with_source "🙂" (fun _ _ location -> assert (Editor_diagnostics.span (location 1 2) = None))
+        );
+      ]
+    );
+  ]
